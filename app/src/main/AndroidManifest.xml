<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+: pedida na hora de plantar (PlantarTela). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Previsão do tempo e busca de cidade (Open-Meteo). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Uma vez, para achar a cidade ("Usar minha localização"); nunca em segundo plano. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".JardimApp"
        android:icon="@mipmap/ic_launcher"
        android:label="Jardim"
        android:theme="@style/Theme.Jardim">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Botões "Feito" e "Não precisou" das notificações. -->
        <receiver
            android:name=".avisos.AcaoAvisoReceiver"
            android:exported="false" />
    </application>
</manifest>
